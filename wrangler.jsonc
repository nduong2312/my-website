{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-website",
  "main": "./src/index.ts",
  "compatibility_date": "2026-06-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  }
}
